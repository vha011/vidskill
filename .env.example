# Copy thành .env ở gốc repo (không commit). Dùng bởi skills-v2/_shared/scripts/muse.py
# muse2api chạy trên máy này hoặc máy trong mạng nội bộ (pool tài khoản Muse)
MUSE_HOST=127.0.0.1
MUSE_PORT=18610
# khóa MUSE2API_KEY đã đặt khi khởi động muse2api (để trống nếu muse2api không bật khóa)
MUSE_API_KEY=
MUSE_IMAGE_MODEL=muse-image
# để trống nếu muse2api không yêu cầu model cho /v1/videos
MUSE_VIDEO_MODEL=
# hoặc ghi đè cả địa chỉ: MUSE_BASE_URL=http://192.168.1.10:18610/v1
